# --- Python / venvs (rebuild the widget venv from widget/requirements.txt)
.venv/
venv/
__pycache__/
*.pyc

# --- Audio and video: never in git (your recordings stay on your PC)
*.wav
*.flac
*.mp3
*.m4a
*.ogg
*.opus
*.aac
*.wma
*.webm
*.mp4
*.mkv
*.mov
# transcripts the batch script writes
*.srt

# --- Data: training data, runtime logs, state and test clips live in the data folder
#     (%LOCALAPPDATA%\ParakeetLive by default), outside this repo. Never commit them.
data/
training-data/
test-samples/
state/
logs/
runtime-logs/
eval-sets/
*.log
*.jsonl

# --- Models, checkpoints, adapters (downloaded at setup; never redistributed here)
models/
adapters/
*.nemo
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.bin
*.npz
*.npy

# --- Machine-specific widget state (window position, mic, settings, data_dir path)
widget/config.json
widget/config.json.*
widget/selftest-result*.json
widget/screenshot*.png
widget/icons/preview-*.png

# --- Secrets, shortcuts, backups
.env
.env.*
*.lnk
*.bak
*.bak-*
*.tmp
*.orig

# --- Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini